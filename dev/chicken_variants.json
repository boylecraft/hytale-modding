{
  "version": 1,
  "server_version": "2026.02.19-1a311a592",
  "outputs": {
    "model_dir": "Server/Models/Livestock",
    "role_dir": "Server/NPC/Roles/Creature/Livestock"
  },
  "sources": {
    "model": {
      "base": "Server/Models/Livestock/Chicken.json"
    },
    "role": {
      "base": "Server/NPC/Roles/Creature/Livestock/Chicken.json"
    }
  },
  "variants": [
    {
      "id": "Chicken_Bobby",
      "patches": {
        "model": [
          {
            "op": "replace",
            "path": "/Texture",
            "value": {
              "$gen_texture": {
                "from": {
                  "$base_model_texture": true
                },
                "transform": {
                  "resize": { "scale": 4, "resample": "nearest" },
                  "desaturate": {
                    "amount": 0.3
                  },
                  "tint": {
                    "rgba": [
                      0.3,
                      0.3,
                      0.3,
                      0.80
                    ],
                    "amount": 1.0
                  },
                  "opacity": {
                    "amount": 0.80,
                    "mode": "dither",
                    "pattern": "blue_noise"
                  }
                },
                "out": "NPC/Livestock/Chicken_Variants/Bobby/Models/Texture.png"
              }
            }
          }
        ],
        "role": [
          {
            "op": "replace",
            "path": "/Modify/Appearance",
            "value": "Chicken_Bobby"
          },
          {
            "op": "replace",
            "path": "/Parameters/NameTranslationKey/Value",
            "value": "better_variants.npcRoles.Chicken_Bobby.name"
          }
        ]
      }
    },
    {
      "id": "Chicken_Speckles",
      "patches": {
        "model": [
          {
            "op": "replace",
            "path": "/Texture",
            "value": "NPC/Livestock/Chicken_Variants/Speckles/Models/Texture.png"
          }
        ],
        "role": [
          {
            "op": "replace",
            "path": "/Modify/Appearance",
            "value": "Chicken_Speckles"
          },
          {
            "op": "replace",
            "path": "/Parameters/NameTranslationKey/Value",
            "value": "better_variants.npcRoles.Chicken_Speckles.name"
          }
        ]
      }
    }
  ]
}