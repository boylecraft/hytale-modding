{
    "version": 1,
    "server_version": "2026.02.19-1a311a592",
    "outputs": { "model_dir": "Server/Models/Livestock", "role_dir": "Server/NPC/Roles/Creature/Livestock" },
    "sources": {
        "model": { "base": "Server/Models/Livestock/Chicken.json" },
        "role": { "base": "Server/NPC/Roles/Creature/Livestock/Chicken.json" }
    },
    "variants": [
        {
            "id": "Chicken_Favorelle",
            "patches": {
                "model": [
                    {
                        "op": "replace",
                        "path": "/Texture",
                        "value": "NPC/Livestock/Chicken_Variants/Favorelle/Models/Texture.png"
                    }
                ],
                "role": [
                    { "op": "replace", "path": "/Modify/Appearance", "value": "Chicken_Favorelle" },
                    {
                        "op": "replace",
                        "path": "/Parameters/NameTranslationKey/Value",
                        "value": "better_variants.npcRoles.Chicken_Favorelle.name"
                    }
                ]
            }
        },
        {
            "id": "Chicken_Bobby",
            "patches": {
                "model": [
                    {
                        "op": "add",
                        "path": "/Particles",
                        "value": [
                            {
                                "Color": "#999933",
                                "SystemId": "Candle_Fire",
                                "Scale": 2,
                                "RotationOffset": { "Pitch": 0 },
                                "PositionOffset": { "Y": 0.2 }
                            }
                        ]
                    },
                    {
                        "op": "replace",
                        "path": "/Texture",
                        "value": {
                            "$gen_texture": {
                                "from": { "$base_model_texture": true },
                                "transform": [
                                    { "op": "resize", "scale": 4, "resample": "nearest" },
                                    {
                                        "op": "mask",
                                        "id": "EyeMask",
                                        "mode": "from_mask",
                                        "src": {
                                            "path": "NPC/Livestock/Chicken_Variants/Bobby/Models/EyeMask.png",
                                            "channel": "luma",
                                            "invert": false
                                        }
                                    },
                                    {
                                        "op": "mask",
                                        "id": "OutlineMask",
                                        "mode": "outline_uv_faces",
                                        "thickness": 3,
                                        "margin": 0,
                                        "save": true,
                                        "invert": true
                                    },
                                    {
                                        "op": "mask_combine",
                                        "id": "EyeOrOutline",
                                        "expr": {
                                            "op": "and",
                                            "inputs": [{ "$ref": "EyeMask" }, { "$ref": "OutlineMask" }]
                                        },
                                        "save": true
                                    },
                                    {
                                        "op": "desaturate",
                                        "amount": 0.5,
                                        "mask": { "$ref": "EyeMask", "invert": false }
                                    },
                                    {
                                        "op": "tint",
                                        "rgba": [ 0.2, 0.2, 0.2, 0.8 ],
                                        "amount": 1,
                                        "mask": { "$ref": "EyeMask", "invert": false }
                                    },
                                    {
                                        "op": "tint",
                                        "rgba": [ 0.6, 0.6, 0.2, 0.8 ],
                                        "amount": 1,
                                        "mask": { "$ref": "EyeMask", "invert": true }
                                    },
                                    {
                                        "op": "tint",
                                        "rgba": [ 0.5, 0.2, 0.2, 0.8 ],
                                        "amount": 1,
                                        "mask": { "$ref": "OutlineMask", "invert": true }
                                    },
                                    {
                                        "op": "opacity",
                                        "amount": 0.3,
                                        "mode": "dither",
                                        "pattern": "blue_noise",
                                        "mask": {
                                            "$ref": "EyeOrOutline",
                                            "channel": "luma",
                                            "threshold": 0.5,
                                            "invert": false
                                        }
                                    }
                                ],
                                "out": "NPC/Livestock/Chicken_Variants/Bobby/Models/Texture.png"
                            }
                        }
                    }
                ],
                "role": [
                    { "op": "replace", "path": "/Modify/Appearance", "value": "Chicken_Bobby" },
                    {
                        "op": "replace",
                        "path": "/Parameters/NameTranslationKey/Value",
                        "value": "better_variants.npcRoles.Chicken_Bobby.name"
                    }
                ]
            }
        }
    ]
}